    vec3(0.000, 1.000, 0.578), vec3(0.000, 0.392, 1.000), vec3(1.000, 0.078, 0.366), vec3(1.000, 0.434, 0.000), vec3(1.000, 0.102, 0.037), // 2 lagoonPop
    vec3(0.565, 1.000, 0.000), vec3(1.000, 0.791, 0.000), vec3(1.000, 0.195, 0.000), vec3(1.000, 0.000, 0.100), vec3(0.000, 1.000, 0.195), // 3 acidCitrus
    vec3(0.000, 0.871, 1.000), vec3(0.000, 0.133, 1.000), vec3(1.000, 0.047, 0.000), vec3(1.000, 0.552, 0.000), vec3(1.000, 0.000, 0.156), // 4 iceFire
    vec3(0.000, 1.000, 0.332), vec3(0.000, 0.658, 1.000), vec3(0.047, 0.102, 0.991), vec3(1.000, 0.823, 0.000), vec3(0.328, 1.000, 0.000), // 5 electricMint
    vec3(1.000, 0.347, 0.000), vec3(1.000, 0.074, 0.000), vec3(0.791, 0.000, 0.195), vec3(0.144, 0.000, 0.905), vec3(0.000, 0.539, 1.000), // 6 mangoBerry
    vec3(1.000, 0.050, 0.371), vec3(1.000, 0.347, 0.050), vec3(1.000, 0.784, 0.050), vec3(0.050, 1.000, 0.434), vec3(0.050, 0.479, 1.000), // 7 candyShop
    vec3(0.000, 1.000, 0.235), vec3(0.000, 0.745, 0.565), vec3(0.000, 0.296, 1.000), vec3(0.254, 0.024, 1.000), vec3(1.000, 0.028, 0.631), // 8 aurora
    vec3(1.000, 0.014, 0.014), vec3(1.000, 0.144, 0.000), vec3(1.000, 0.479, 0.000), vec3(1.000, 0.791, 0.000), vec3(1.000, 0.000, 0.212), // 9 lavaLamp
    vec3(0.784, 1.000, 0.000), vec3(0.000, 1.000, 0.133), vec3(0.000, 0.694, 1.000), vec3(0.000, 0.080, 1.000), vec3(1.000, 0.434, 0.000), // 10 cyberLime
    vec3(1.000, 0.102, 0.114), vec3(1.000, 0.026, 0.301), vec3(0.397, 0.045, 1.000), vec3(0.026, 0.198, 1.000), vec3(0.000, 0.807, 0.565), // 11 coralReef
    vec3(1.000, 0.631, 0.000), vec3(1.000, 0.254, 0.000), vec3(1.000, 0.044, 0.044), vec3(1.000, 0.195, 0.000), vec3(1.000, 0.871, 0.074), // 12 goldRush
    vec3(0.000, 0.010, 1.000), vec3(0.000, 0.283, 1.000), vec3(0.000, 0.913, 0.658), vec3(0.328, 1.000, 0.000), vec3(1.000, 0.791, 0.000), // 13 deepNeon
    vec3(1.000, 0.195, 0.565), vec3(0.571, 0.205, 1.000), vec3(0.195, 0.392, 1.000), vec3(0.195, 1.000, 0.745), vec3(1.000, 0.871, 0.195), // 14 bubbleTea
    vec3(1.000, 0.000, 0.091), vec3(0.133, 0.000, 1.000), vec3(0.000, 0.451, 1.000), vec3(0.000, 1.000, 0.665), vec3(0.468, 1.000, 0.000) // 15 neonTokyo
);
const float OS_PAL_COUNT = 16.0;

// Linear mix that keeps the endpoints' channel range, so a blend between two
// saturated colours stays saturated instead of passing through grey.
vec3 osVividMix(vec3 a, vec3 b, float w) {
    vec3 m = mix(a, b, w);
    float lo = min(m.r, min(m.g, m.b)), hi = max(m.r, max(m.g, m.b));
    float tlo = mix(min(a.r, min(a.g, a.b)), min(b.r, min(b.g, b.b)), w);
    float thi = mix(max(a.r, max(a.g, a.b)), max(b.r, max(b.g, b.b)), w);
    return tlo + (m - lo) * ((thi - tlo) / max(hi - lo, 1e-3));
}

vec3 osPalLoop(float t, int idx) {
    float f = fract(t) * 5.0;
    int i = int(floor(f));
    i = clamp(i, 0, 4);
    int j = i == 4 ? 0 : i + 1;
    return osVividMix(OS_PAL[idx * 5 + i], OS_PAL[idx * 5 + j], smoothstep(0.0, 1.0, f - float(i)));
}

vec3 osPalVisual(float t, VisualUniforms u) {
    if (u.palette.x >= 0.0) return palVisual(t, u);
    float phase = u.palette.z;
    int a = int(mod(floor(phase), OS_PAL_COUNT));
    int b = int(mod(float(a + 1), OS_PAL_COUNT));
    float blend = smoothstep(0.18, 0.82, fract(phase));
    float nudge = phase * 0.25 + u.beatPhase * 0.015 + u.spectralCentroid * 0.08;
    return osVividMix(osPalLoop(t + nudge, a), osPalLoop(t + nudge, b), blend);
}

// The calm visuals' audio response, 0..0.25: the music's level, which rises
// and falls with the song, scaled by the sensitivity. Not the kick: a calm
// visual's light never jumps on the beat.
float osCalmBreath(VisualUniforms u) {
    return 0.25 * saturate(u.level) * (0.5 + 0.5 * u.sensitivity);
}

// The calm visuals' palette read: the visual's own library palette `own`
// (its manifest palette) at t, with no beat or spectral nudge. Under the vivid
// palette tour (palette.x < 0) a calm visual keeps `own`: the tour moves
// through sixteen neon palettes of very different brightness every few
// seconds, which turns a moonlit sea orange and swells the light, so vivid
// leaves a calm visual only its present-pass saturation. A host's manifest
// palette (palette.x >= 0) still replaces it.
vec3 osPalCalm(float t, int own, VisualUniforms u) {
    return palByIndex(t, u.palette.x >= 0.0 ? int(floor(u.palette.x + 0.5)) : own);
}

// The library's palette roles, reading osPalVisual.
vec3 osPalRoleTrace(float t, VisualUniforms u) { return osPalVisual(t + 0.03 * u.beatPhase, u); }
vec3 osPalRoleBass(float t, VisualUniforms u) {
    vec3 hot = osPalVisual(0.03 + t * 0.18 + 0.04 * u.beatPhase, u);
    vec3 body = osPalVisual(t + 0.10, u);
    return mix(body, hot, 0.62 + 0.25 * u.bassImpact);
}
vec3 osPalRoleTreble(float t, VisualUniforms u) {
    vec3 spark = osPalVisual(0.62 + t * 0.28 + 0.10 * u.spectralCentroid, u);
    return peakWhite(spark, u.treble * u.onset * 0.14);
}
vec3 osPalRolePeak(float t, VisualUniforms u) {
    return peakWhite(osPalVisual(t + 0.08 * u.spectralCentroid, u), saturate(u.onset * 0.18 + u.bassImpact * 0.10));
}
vec3 osPalRoleFog(float t, VisualUniforms u) {
    vec3 c = osPalVisual(t + 0.04 * u.spectralCentroid, u);
    return mix(vec3(luma(c) * 0.62), c, 0.42);
}
vec3 osPalRoleRim(float t, VisualUniforms u) {
    return mix(osPalVisual(t, u), osPalRolePeak(t + 0.18, u), 0.35 + 0.35 * u.flux);
}

// Every original finishes through osOffRed. The present pass grades with the vivid saturation
// and vibrance (palette.rs), which pushes a nearly pure red past the 0.8 red share at which the
// flash limiter counts saturated red and holds it. Where green plus blue is under 0.55 of red
// (linear light), both rise by half the difference, so the graded red presents under a 0.77
// share. Near black the present dither can still split a dim red into a saturated-red byte
// triple such as (1, 0, 0), so a dim colour becomes exactly grey and a dim red loses its excess
// over green and blue, which then ramps back in (limiter-red-expire-black, design.md section 3;
// tools/shader/test-originals-red.mjs). A quality measure: the frame limiter carries the safety
// claim. NaN becomes 0 by a boolean select, exact on targets honouring IEEE NaN.
const float OS_GREY_BELOW = 0.006;  // below it the colour becomes exactly grey
const float OS_RED_FROM = 0.012;    // below it red is at most the larger of green and blue
const float OS_RED_FULL = 0.05;     // red's excess is whole from here, and red returned as it stands
vec3 osOffRed(vec3 c) {
    c = mix(c, vec3(0.0), notEqual(c, c));      // NaN -> 0
    c = clamp(c, vec3(0.0), vec3(16.0));
    float s = c.g + c.b, t = 0.55 * c.r;        // gated on the rounded sum and product, so a
    if (s < t) c += vec3(0.0, 0.5 * (t - s), 0.5 * (t - s));  // colour that meets the share is kept
    float m = max(c.r, max(c.g, c.b));
    if (m < OS_GREY_BELOW) return vec3(luma(c));  // three identical channels
    float p = max(c.g, c.b);
    if (c.r > p && m < OS_RED_FULL) {           // no saturated red byte from the present dither
        float w = clamp((m - OS_RED_FROM) / (OS_RED_FULL - OS_RED_FROM), 0.0, 1.0);
        c.r = w <= 0.0 ? p : p + w * (c.r - p);  // red equal to a partner below OS_RED_FROM
    }
    return c;
}

// Everything joined after this file reads the vivid set through the usual names.
#define palVisual osPalVisual
#define palRoleTrace osPalRoleTrace
#define palRoleBass osPalRoleBass
#define palRoleTreble osPalRoleTreble
#define palRolePeak osPalRolePeak
#define palRoleFog osPalRoleFog
#define palRoleRim osPalRoleRim

uniform VisualUniforms u;
vec3 feedbackTrail(vec3 col, vec2 uv, float decay, float zoom, float rotAmt) {
    float n = u.dt > 0.0 ? min(u.dt * 60.0, 4.0) : 1.0;
    vec2 q = uv - 0.5;
    q = rot2(rotAmt * n) * q;
    q *= pow(max(1.0 - zoom, 1e-4), n);
    vec2 s = q + 0.5;
    vec2 out2 = max(-s, s - 1.0);
    float inside = clamp(1.0 - 32.0 * max(max(out2.x, out2.y), 0.0), 0.0, 1.0);
    vec3 p = suppressGreenCast(PREV(s).rgb) * inside;
    float k = pow(clamp(decay, 0.0, 0.90), n);
    return suppressGreenCast(max(suppressGreenCast(col), p * k));
}
// SPDX-License-Identifier: AGPL-3.0-only
// Dunes.
// A low, fast skim over a sea of sharp-crested dunes at sunset. The low sun
// rakes across the slip faces, so every ridge splits into a burning lit side
// and a cool shadow side; sand streams off the crests in the wind; heat haze
// shimmers and pools into a mirage at the horizon under a banded, cloud-torn
// sky. The camera glides at a steady, unhurried pace with a level horizon.
// Audio only breathes in the light: the smoothed level and a gentle spectrum
// term warm the crest lines by position and the sun's rays, sand streams lift
// a little with the bass, and fine glints twinkle slowly in the sand. Nothing
// flashes on the beat, so the scene stays calm under loud music.
// param0 = Speed ; param1 = Height (dune height) ; param2 = Dune Density

// The palette read without the library's per-beat and spectral-centroid hue
// nudge, so large lit areas never shimmer with the music; under the host's
// palette tour the cross-fade between palettes is spread over the whole tour
// step, so the colours change slowly.
vec3 dnPalStill(float t, VisualUniforms u) {
    if (u.palette.x >= 0.0) return palByIndex(t, int(floor(u.palette.x + 0.5)));
    int a = int(mod(floor(u.palette.z), 32.0));
    int b = int(mod(float(a + 1), 32.0));
    float blend = smoothstep(0.0, 1.0, fract(u.palette.z));
    return mix(palByIndex(t, a), palByIndex(t, b), blend);
}

float dnPath(float z) { return 30.0 * sin(z * 0.006) + 12.0 * sin(z * 0.017 + 2.0); }

// Broad swells the dune field rides on.
float dnSwell(vec2 p) { return 3.0 * sin(p.x * 0.011 + 1.0) * sin(p.y * 0.008) + 2.0 * sin(p.y * 0.005 + p.x * 0.003); }

// Asymmetric dune profile: a long windward rise to a sharp crest at s = 0.72,
// then a steep slip face.
float dnProfile(float q) {
    float s = fract(q);
    float up = s / 0.72;
    up = up * up * (1.6 - 0.6 * up);
    float dn = (1.0 - s) / 0.28;
    return s < 0.72 ? up : dn * dn * (3.0 - 2.0 * dn);
}

// Ridge coordinate: crests run diagonally across the flight path and
// meander; the slip faces look along +DN_WIND.
const vec2 DN_WIND = vec2(0.5, -0.866);

float dnHeight(vec2 p, float amp, float dens, out float ridge) {
    float w1 = vnoise(p * 0.018);
    float w2 = vnoise(p * 0.05 + 3.0);
    // a slow field-scale noise bends the rows and sets their size, so the
    // distant crests never stack into even bands
    float w0 = 0.5 + 0.28 * sin(dot(p, vec2(0.0061, 0.0023)) + 1.7) + 0.22 * sin(dot(p, vec2(-0.0019, 0.0073)) + 4.1);
    float warp = 9.0 * w1 + 4.0 * w2 + 30.0 * w0;
    ridge = (dot(p, DN_WIND) + 12.0 * sin(dot(p, vec2(0.866, 0.5)) * 0.025 + 1.3) + warp) * dens / 22.0;
    float h = dnProfile(ridge) * (0.3 + 0.45 * w1 + 0.35 * w0);
    // a smaller crossing set breaks the rows into linked crescents
    float q2 = (dot(p, vec2(0.94, -0.34)) + warp * 0.8) * dens / 10.0;
    h = -osSmin(-h, -0.32 * dnProfile(q2), 0.12);
    return h * amp + dnSwell(p);
}

float dnH(vec2 p, float amp, float dens) {
    float r;
    return dnHeight(p, amp, dens, r);
}

vec3 dnSky(vec3 rd, vec3 sunDir, VisualUniforms u, float tm) {
    float h = rd.y;
    float sd = saturate(dot(rd, sunDir));
    float sdw = saturate(dot(normalize(vec3(rd.x, 0.0, rd.z) + 1e-4), normalize(vec3(sunDir.x, 0.0, sunDir.z))));
    vec3 hot = dnPalStill(0.58, u) * vec3(1.25, 0.7, 0.45);
    vec3 band = dnPalStill(0.3, u) * vec3(0.9, 0.3, 0.42) + vec3(0.06, 0.0, 0.05);
    vec3 zen = vec3(0.008, 0.012, 0.05) + dnPalStill(0.1, u) * 0.015;
    // the horizon burns toward the sun and cools to crimson away from it
    vec3 hor = mix(band * 0.9, hot, pow(sdw, 3.0));
    vec3 col = mix(hor, band * 0.5, smoothstep(0.0, 0.12, h));
    col = mix(col, zen, smoothstep(0.06, 0.5, h));
    // the sun: a white-hot disc in an amber glow
    col += hot * pow(sd, 14.0) * 0.5 + dnPalStill(0.85, u) * pow(sd, 120.0) * 1.6;
    col += vec3(7.0, 5.2, 3.2) * smoothstep(0.99925, 0.99955, sd);
    // rays fanned around the sun, each lit by its spectrum band
    vec3 sx = normalize(cross(sunDir, vec3(0.0, 1.0, 0.0)));
    vec3 sy = cross(sx, sunDir);
    float ang = atan2_(dot(rd, sy), dot(rd, sx));
    float fan = ang * 0.15915 + 0.5;
    float ray = vnoise(vec2(fan * 44.0, tm * 0.08));
    ray = smoothstep(0.4, 0.95, ray);
    float rb = bandAt(u, abs(fract(fan * 2.0) * 2.0 - 1.0));
    col += hot * ray * (0.12 + 0.12 * u.level + 0.08 * rb) * pow(sd, 7.0) * smoothstep(-0.02, 0.06, h);
    // torn cloud bands: dark bellies with burning edges toward the sun
    // high cirrus: long thin wind-combed streaks, dark undersides and
    // hairline silver-gold edges, instead of soft painted cloud
    vec2 cp = rd.xz / max(h + 0.05, 0.03);
    vec2 cq = cp * vec2(0.22, 1.9) + vec2(tm * 0.015, 0.0);
    cq.y += 0.9 * vnoise(cp * 0.35);
    float c = vnoise(cq) * 0.62 + vnoise(cq * vec2(2.3, 3.1) + 4.0) * 0.38;
    float cm = smoothstep(0.6, 0.7, c) * smoothstep(0.08, 0.16, h) * (1.0 - smoothstep(0.25, 0.55, h));
    float edge = smoothstep(0.6, 0.65, c) - smoothstep(0.65, 0.76, c);
    vec3 cl = mix(vec3(0.02, 0.01, 0.035) + band * 0.08, hot * 0.35, pow(sd, 3.0));
    cl += hot * edge * (0.5 + 3.0 * pow(sd, 5.0));
    col = mix(col, cl, cm * 0.85);
    return col;
}

vec3 osBody(vec2 uv, VisualUniforms u) {
    vec2 p = centered(uv, u.resolution);
    p.y = -p.y;
    float detail = osDetail(u);
    float tm = mod(u.time, 600.0);

    float speed = mix(6.0, 18.0, u.param0);
    float amp = mix(1.6, 4.4, u.param1);
    float dens = mix(0.6, 1.5, u.param2);
    float z = mod(speed * 0.25 * u.time, 20000.0);
    vec3 ro = vec3(dnPath(z), 0.0, z);
    // ride the broad swell, clear of every crest; the audio never moves it
    ro.y = dnSwell(ro.xz) + amp * 1.6 + 2.2;
    vec3 ta = vec3(dnPath(z + 24.0), 0.0, z + 24.0);
    ta.y = dnSwell(ta.xz) + amp * 1.0 + 0.8;
    float roll = -0.01 * (dnPath(z + 30.0) - 2.0 * dnPath(z + 15.0) + dnPath(z));
    float fov = 1.35;
    vec3 rd = osCamera(ro, ta, roll, fov, p);

    // heat haze: a shimmer that thickens toward the horizon
    float shimmer = exp(-abs(rd.y) * 22.0);
    rd.y += shimmer * 0.002 * (vnoise(vec2(p.x * 22.0, p.y * 90.0 - tm * 1.2)) - 0.5);
    rd = normalize(rd);

    vec3 sunDir = normalize(vec3(-0.62, 0.075, 1.0));
    vec3 col = vec3(0.0);

    float tmax = 520.0;
    float t = 0.3;
    float tPrev = t;
    float hit = 0.0;
    float spray = 0.0;
    int nMax = osSteps(44.0, 92.0, detail);
    for (int i = 0; i < 92; i++) {
        if (i >= nMax) break;
        vec3 pos = ro + rd * t;
        float rg;
        float dh = pos.y - dnHeight(pos.xz, amp, dens, rg);
        if (dh < 0.0015 * t) { hit = 1.0; break; }
        if (rd.y >= 0.0 && pos.y > amp * 1.5 + 5.5) break;
        // sand blown off a crest the ray skims over
        float cs = fract(rg) - 0.72;
        float step_ = max(dh * 0.42, 0.02 + 0.008 * t);
        spray += exp(-cs * cs * 500.0 - dh * 3.0) * step_ * exp(-t * 0.012);
        tPrev = t;
        t += step_;
        if (t > tmax) break;
    }
    if (hit > 0.5) {
        for (int i = 0; i < 5; i++) {
            float tb = 0.5 * (t + tPrev);
            vec3 pb = ro + rd * tb;
            if (pb.y - dnH(pb.xz, amp, dens) < 0.0) t = tb; else tPrev = tb;
        }
        vec3 pos = ro + rd * t;
        float ridge;
        float hc = dnHeight(pos.xz, amp, dens, ridge);
        float e = 0.02 + 0.0015 * t;
        vec3 n = normalize(vec3(hc - dnH(pos.xz + vec2(e, 0.0), amp, dens), e,
                                hc - dnH(pos.xz + vec2(0.0, e), amp, dens)));
        // wind ripples, near the camera only and faint: the camera sweeps over
        // them fast enough that deep ripples flicker the near sand
        float rf = saturate(1.0 - t / 45.0);
        float rp = dot(pos.xz, DN_WIND) * 11.0 + 0.9 * sin(dot(pos.xz, vec2(0.866, 0.5)) * 1.7) + 2.0 * vnoise(pos.xz * 0.6);
        float rpl = sin(rp);
        rpl = rpl * abs(rpl);
        n = normalize(n + vec3(DN_WIND.x, 0.0, DN_WIND.y) * rpl * 0.1 * rf);

        // long shadows from the low sun
        float sh = 1.0;
        if (detail > 0.0) {
            float ts = 0.4;
            int ns = osSteps(6.0, 12.0, detail);
            for (int i = 0; i < 12; i++) {
                if (i >= ns) break;
                vec3 ps = pos + sunDir * ts;
                float d = ps.y - dnH(ps.xz, amp, dens);
                sh = min(sh, saturate(8.0 * d / ts));
                if (sh < 0.01) break;
                ts += max(d * 0.6, 0.6 + 0.18 * ts);
            }
        }
        // cloud shadows roll across the field with the wind
        float cloud = smoothstep(0.42, 0.72, vnoise(pos.xz * 0.011 + vec2(tm * 0.55, tm * 0.2)));
        sh *= 1.0 - 0.75 * cloud;
        float dif = saturate(dot(n, sunDir));
        vec3 sunCol = dnPalStill(0.6, u) * vec3(1.9, 1.05, 0.6);
        // shade is lit by the burning sky: rose low, violet from above
        // the shade takes the cool sky: lilac on the slopes, deep blue
        // under the crests, the complement of the burning lit sides
        vec3 shadeCol = mix(vec3(0.32, 0.06, 0.42), vec3(0.04, 0.1, 0.62), saturate(n.y * 1.2 - 0.1)) + dnPalStill(0.2, u) * 0.03;
        vec3 sand = mix(vec3(0.8, 0.46, 0.27), dnPalStill(0.7, u), 0.35);
        vec3 sandShade = mix(sand, vec3(0.75), 0.5);
        // plus warm light bounced off the sunlit slopes into the shade
        vec3 lit = sand * sunCol * dif * sh * 1.6 + sandShade * shadeCol * 0.38 * (0.85 + 0.1 * rpl * rf)
                 + sand * sunCol * 0.025 * (1.0 - dif * sh) * (0.6 + 0.4 * n.y);
        // glossy sheen: the backlit sand mirrors the sun
        vec3 hv = normalize(sunDir - rd);
        float spec = pow(saturate(dot(n, hv)), 36.0);
        lit += sunCol * spec * (0.25 + 0.5 * sh) * 0.8 * exp(-t * 0.008);

        // the crest line burns, lit by the spectrum across the view
        float s = fract(ridge);
        float crest = exp(-(s - 0.72) * (s - 0.72) * 30000.0 / (1.0 + t * 0.05));
        crest *= 0.35 + 0.65 * hash11(mod(floor(ridge), 512.0) + 0.37);
        float xb = saturate(0.5 + 0.35 * p.x);
        float drive = 0.75 + 0.15 * u.level + 0.12 * bandAt(u, 0.05 + 0.8 * xb);
        vec3 crestCol = mix(sunCol * 1.3, dnPalStill(0.8, u), 0.35);
        // far crests break into lit segments and fade, so the rows near the
        // horizon never stack into even bands
        float brk = smoothstep(0.3, 0.7, vnoise(vec2(dot(pos.xz, vec2(0.866, 0.5)) * 0.06, floor(ridge) * 3.7)));
        crest *= mix(1.0, brk, saturate(t / 50.0));
        lit += crestCol * crest * drive * (0.3 + 0.9 * sh) * exp(-t * 0.04);
        // the cool sky rims the shadowed flanks: the complement of the burning
        // crests, steady and soft
        float rim = pow(1.0 - saturate(dot(n, -rd)), 5.0) * saturate(0.2 - 2.0 * dot(n, sunDir)) * sh;
        vec3 cool = mix(vec3(0.2, 0.32, 1.0), dnPalStill(0.3, u), 0.25);
        lit += cool * rim * (0.12 + 0.03 * u.level) * exp(-t * 0.01);
        // treble glints in the sand near the camera
        vec2 gc = floor(pos.xz * 26.0);
        float g = step(0.992, hash21(gc + floor(mod(tm * 1.5, 100.0)))) * rf * sh * (0.15 + 4.0 * spec + dif);
        lit += vec3(4.5, 3.6, 2.4) * g * (0.35 + 0.1 * u.level);

        // dusty aerial perspective, warm toward the sun
        float fog = 1.0 - exp(-t * 0.0055);
        // far rows melt into the dust so the horizon never stacks into bands
        fog = max(fog, 0.75 * smoothstep(70.0, 260.0, t));
        vec3 dust = mix(dnPalStill(0.3, u) * vec3(0.35, 0.12, 0.16), dnPalStill(0.6, u) * 0.9, pow(saturate(dot(rd, sunDir)), 4.0));
        col = mix(lit, dust, fog);
        // the mirage: far sand near the horizon turns into a shimmering sky mirror
        float mir = smoothstep(80.0, 300.0, t) * exp(-abs(rd.y) * 45.0);
        vec3 mrd = normalize(vec3(rd.x, abs(rd.y) + 0.01, rd.z));
        if (mir > 0.01) col = mix(col, dnSky(mrd, sunDir, u, tm) * 0.9, mir * 0.85);
    } else {
        col = dnSky(rd, sunDir, u, tm);
    }
    // blown sand glowing in the low sun, streaked by the wind
    float sw = 0.3 + 1.2 * vnoise(vec2(p.x * 7.0 - tm * 2.5, p.y * 4.0 + tm * 0.5));
    col += dnPalStill(0.62, u) * vec3(1.3, 0.8, 0.5) * spray * sw * (0.12 + 0.06 * u.level + 0.04 * u.bass)
         * (0.4 + 1.2 * pow(saturate(dot(rd, sunDir)), 2.0));
    // the low sun's glare spills softly over the dunes
    col += dnPalStill(0.6, u) * pow(saturate(dot(rd, sunDir)), 40.0) * (0.2 + 0.03 * u.level);
    return col; // LINEAR HDR — post chain tonemaps
}

// Reds stay off saturated red through the vivid present (common.glsl).
vec3 visual(vec2 uv, VisualUniforms u) { return osOffRed(osBody(uv, u)); }

in vec2 vUV;
layout(location=0) out vec4 fragColor;
void main() {
    fragColor = vec4(suppressGreenCast(visual(vUV, u)), 1.0);
}
