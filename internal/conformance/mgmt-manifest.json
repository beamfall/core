  "managementRoutes": [
    {
      "method": "POST",
      "pattern": "/api/setup",
      "note": "First-run setup bootstrap (admin password, first Library, owner Profile)"
    },
    {
      "method": "POST",
      "pattern": "/api/media/artwork-upload/{recordID}",
      "note": "Create Media from an unmatched-review record and pin uploaded poster artwork",
      "authorization": "manager-admin-session",
      "request": {
        "contentType": "multipart/form-data",
        "maxBodyBytes": 10551296,
        "pathFields": [
          {
            "name": "recordID",
            "type": "string",
            "required": true
          }
        ],
        "multipartFields": [
          {
            "name": "libraryID",
            "type": "string",
            "required": true
          },
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "year",
            "type": "integer",
            "required": false,
            "minimumInteger": 0
          },
          {
            "name": "artwork",
            "type": "binary",
            "required": true,
            "maxBytes": 10485760,
            "maxPixels": 40000000,
            "acceptedContentTypes": [
              "image/jpeg",
              "image/png"
            ]
          }
        ]
      },
      "success": {
        "status": 201,
        "contentType": "application/json",
        "fields": [
          {
            "name": "mediaID",
            "type": "string",
            "required": true
          }
        ]
      },
      "errors": [
        {
          "status": 400,
          "messages": [
            "recordID, libraryID, and title are required",
            "artwork is required",
            "could not read artwork",
            "invalid multipart body"
          ]
        },
        {
          "status": 401,
          "messages": [
            "invalid session"
          ]
        },
        {
          "status": 403,
          "messages": [
            "manager role required"
          ]
        },
        {
          "status": 409,
          "messages": [
            "unmatched record was resolved by a different request"
          ]
        },
        {
          "status": 413,
          "messages": [
            "artwork is too large"
          ]
        },
        {
          "status": 415,
          "messages": [
            "Content-Type must be multipart/form-data",
            "artwork must be a valid JPEG or PNG image"
          ]
        },
        {
          "status": 500,
          "messages": [
            "could not create Media with artwork"
          ]
        },
        {
          "status": 503,
          "messages": [
            "artwork upload unavailable",
            "privileged audit unavailable"
          ]
        }
      ]
    },
    {
      "method": "POST",
      "pattern": "/api/web/enroll",
      "note": "Enroll a web device session"
    },
    {
      "method": "POST",
      "pattern": "/api/web/logout",
      "note": "Logout a web device session"
    },
    {
      "method": "POST",
      "pattern": "/api/web/promote",
      "note": "Promote a web session to Admin Session"
    },
    {
      "method": "POST",
      "pattern": "/api/beam/offers",
      "note": "Create a Beam offer for device pairing"
    },
    {
      "method": "POST",
      "pattern": "/api/beam/claims",
      "note": "Claim a Beam offer (device pairing)"
    },
    {
      "method": "POST",
      "pattern": "/api/pairing-codes",
      "note": "Generate a pairing code for device enrollment"
    },
    {
      "method": "POST",
      "pattern": "/api/enroll",
      "note": "Enroll a native device"
    },
    {
      "method": "POST",
      "pattern": "/api/group/calibrate",
      "note": "Calibrate group watch sync"
    },
    {
      "method": "GET",
      "pattern": "/api/manifest",
      "note": "Navigation Manifest: server-side layout and section configuration"
    },
    {
      "method": "GET",
      "pattern": "/api/events",
      "note": "SSE event fanout: real-time server events for Console/Manage UIs"
    }
  ]
