      "codec": "hevc",
      "width": 3840,
      "height": 2160,
      "video": { "profile": "Main 10", "doViProfile": 8, "doViBLCompatID": 6, "colorTransfer": "smpte2084" },
      "audio": { "codec": "eac3", "channels": 6 },
      "profile": "shield",
      "wantDecision": "direct-play",
      "wantReason": ""
    },
    {
      "name": "P5 file + Shield (advertises dolby-vision-p5) direct-plays",
      "container": "mp4",
