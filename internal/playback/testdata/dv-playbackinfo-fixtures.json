{
  "_comment": "Cross-repo Dolby Vision playbackInfo contract fixtures (NGAUDIT-B4, ADR-0017 §4). Each case pins a probed source-stream shape (the Android probe emits DoViProfile + DoViBLCompatID) against a CapabilityProfile whose hdrFormats are the CLOSED per-profile vocabulary the Android device-quirks table declares verbatim (beamfall-android-ui/kit/.../DeviceQuirksTable.kt:68,81,93,119). A server-side token rename that diverges from these tokens breaks this gate instead of silently forcing DV content into transcode or a false direct-play. The Android repo consuming this same corpus is a follow-up ticket in that repo.",
  "profiles": {
    "shield": {
      "_note": "NVIDIA Shield quirk (DeviceQuirksTable.kt:68): dolby-vision-p5 + dolby-vision-p8.",
      "client": "beamfall-android-tv",
      "containers": ["mp4", "mkv"],
      "videoCodecs": [{ "codec": "hevc", "profiles": ["Main", "Main 10"], "maxHeight": 2160 }],
      "audioCodecs": [{ "codec": "eac3", "maxChannels": 8 }, { "codec": "aac", "maxChannels": 8 }],
      "hdrFormats": ["hdr10", "hdr10plus", "dolby-vision-p5", "dolby-vision-p8", "hlg"]
    },
    "streamer": {
      "_note": "Google TV Streamer quirk (DeviceQuirksTable.kt:81): dolby-vision-p5 + dolby-vision-p8.",
      "client": "beamfall-android-tv",
      "containers": ["mp4", "mkv"],
      "videoCodecs": [{ "codec": "hevc", "profiles": ["Main", "Main 10"], "maxHeight": 2160 }],
      "audioCodecs": [{ "codec": "eac3", "maxChannels": 6 }, { "codec": "aac", "maxChannels": 6 }],
      "hdrFormats": ["hdr10", "hdr10plus", "dolby-vision-p5", "dolby-vision-p8", "hlg"]
    },
    "chromecast": {
      "_note": "Chromecast with Google TV quirk (DeviceQuirksTable.kt:93): dolby-vision-p5 only, no p8.",
      "client": "beamfall-android-tv",
      "containers": ["mp4", "mkv"],
      "videoCodecs": [{ "codec": "hevc", "profiles": ["Main", "Main 10"], "maxHeight": 2160 }],
      "audioCodecs": [{ "codec": "eac3", "maxChannels": 6 }, { "codec": "aac", "maxChannels": 6 }],
      "hdrFormats": ["hdr10", "dolby-vision-p5", "hlg"]
    },
    "pixel": {
      "_note": "Pixel phone quirk (DeviceQuirksTable.kt:141): no Dolby Vision, hdr10 + hlg only.",
      "client": "beamfall-android-tv",
      "containers": ["mp4", "mkv"],
      "videoCodecs": [{ "codec": "hevc", "profiles": ["Main", "Main 10"], "maxHeight": 2160 }],
      "audioCodecs": [{ "codec": "eac3", "maxChannels": 6 }, { "codec": "aac", "maxChannels": 6 }],
      "hdrFormats": ["hdr10", "hlg"]
    }
  },
  "cases": [
