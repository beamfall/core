# Beamfall Core — local development environment.
# Copy to .env and edit. Do NOT commit real secrets.

# Local HTTP listener used by `make dev-run`. Default 127.0.0.1:8090
BEAMFALL_ADDR=127.0.0.1:8090
# Local SQLite/data directory. Keep this out of synced/network folders.
BEAMFALL_DATA_DIR=/tmp/beamfall-core-dev
# Local first-run bootstrap only. CHANGE THIS in your .env before first run.
# DD-8: this value is a well-known dev placeholder — it MUST NOT be used in
# staging or production. Production secrets come from the host secret manager.
BEAMFALL_ADMIN_PASSWORD=beamfall-dev-admin

# Optional development seed data.
BEAMFALL_SEED_DEVELOPMENT_DATA=false
BEAMFALL_SEED_PROFILE=development  # BEAMFALL_SEED is the legacy alias

# Dev/staging/prod convention:
# - dev: local files and loopback hosts only
# - staging: production-shaped hosts with disposable data
# - prod: secrets come from the host secret manager, never .env
BEAMFALL_ENV=dev

# Opt-in version check (LB-2, ADR-0013 §7). Default OFF — uncomment to
# enable.  When enabled, sends a plain GET to the manifest URL below with no
# identifying payload (only a generic User-Agent).  Override the URL to point
# at a self-hosted or air-gapped mirror.
# BEAMFALL_UPDATE_CHECK_BASE_URL=https://updates.beamfall.com/channels

# Public website mock-vs-real toggle lives in beamfall-web:
# unset BEAMFALL_ACCOUNTS_BASE_URL = in-process mock API
# BEAMFALL_ACCOUNTS_BASE_URL=http://127.0.0.1:8080 = real beamfall-cloud
