{
  "capture": {
    "date": "2026-07-10",
    "server": "Jellyfin Server 10.11.11",
    "target": "https://demo.jellyfin.org/stable",
    "consumer": "Seerr 5ae70d05e1ee123b3cda43153ed415754fd8e816"
  },
  "cases": [
    {
      "name": "system-info",
      "request": { "method": "GET", "path": "/System/Info", "headers": { "X-Emby-Token": "<access-token>" } },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": {
          "SupportsLibraryMonitor": true,
          "ServerName": "Stable Demo",
          "Version": "10.11.11",
          "ProductName": "Jellyfin Server",
          "Id": "<server-id>",
          "StartupWizardCompleted": true
        }
      }
    },
    {
      "name": "paged-items",
      "request": {
        "method": "GET",
        "path": "/Items?SortBy=SortName&SortOrder=Ascending&IncludeItemTypes=Series%2CMovie%2COthers&Recursive=true&StartIndex=0&Limit=1&collapseBoxSetItems=false",
        "headers": { "X-Emby-Token": "<access-token>" }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": {
          "Items": [
            {
              "Name": "The Boy in the Plastic Bubble",
              "ServerId": "<server-id>",
              "Id": "<item-id>",
              "ProductionYear": 1976,
              "IsFolder": false,
              "Type": "Movie",
              "UserData": { "PlaybackPositionTicks": 0, "PlayCount": 30, "Played": false, "ItemId": "<item-id>" },
              "ImageTags": { "Primary": "<image-tag>" },
              "BackdropImageTags": ["<image-tag>"],
              "LocationType": "FileSystem",
              "MediaType": "Video"
            }
          ],
          "TotalRecordCount": 12,
          "StartIndex": 0
        }
      }
    },
    {
      "name": "current-user",
      "request": { "method": "GET", "path": "/Users/Me", "headers": { "X-Emby-Token": "<access-token>" } },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": {
          "Name": "demo",
          "ServerId": "<server-id>",
          "Id": "<user-id>",
          "HasPassword": false,
          "Configuration": { "GroupedFolders": [], "SubtitleMode": "Default" },
          "Policy": { "IsAdministrator": false, "IsDisabled": false, "EnableRemoteAccess": true }
        }
      }
    },
    {
      "name": "primary-image",
      "request": { "method": "GET", "path": "/Items/<item-id>/Images/Primary?maxWidth=1", "headers": { "X-Emby-Token": "<access-token>" } },
      "response": { "status": 200, "headers": { "Content-Type": "image/jpeg" }, "body": "<binary-jpeg-288-bytes>" }
    }
  ]
}
